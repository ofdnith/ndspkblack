diff -ruN a/runner/src/pkb_overlay_banks.cpp b/runner/src/pkb_overlay_banks.cpp
--- a/runner/src/pkb_overlay_banks.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/runner/src/pkb_overlay_banks.cpp	2026-10-31 00:07:00.383001924 +0000
@@ -0,0 +1,52 @@
+// pokeblack-recomp (patch 0005): bancos de overlay em módulos.
+// Cada overlay do jogo vira uma biblioteca (pkb_arm9_ovNNN.so / .dylib) que exporta
+// g_dispatch_<nome> e g_dispatch_<nome>_len. Aqui elas são abertas com dlopen e registradas
+// como bancos ARM9; o runtime escolhe a função pelo conteúdo vivo (--validate-live-bytes),
+// então overlays que dividem o mesmo endereço convivem.
+// Pasta: $NDS_BANK_DIR (o build/scripts apontam para local/banks/<sistema>).
+#include "pkb_overlay_banks.h"
+#include "state.h"
+#include <dirent.h>
+#include <dlfcn.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <algorithm>
+
+void pkb_load_overlay_banks(const char* rom_sha1) {
+    if (!rom_sha1 || std::strcmp(rom_sha1, "26ad0b9967aa279c4a266ee69f52b9b2332399a5") != 0) return;
+    const char* dir = std::getenv("NDS_BANK_DIR");
+    if (!dir || !*dir) { std::fprintf(stderr, "[pkb] NDS_BANK_DIR não definido: overlays no interpretador\n"); return; }
+#ifdef __APPLE__
+    const char* ext = ".dylib";
+#else
+    const char* ext = ".so";
+#endif
+    DIR* d = opendir(dir);
+    if (!d) { std::fprintf(stderr, "[pkb] pasta de bancos não abre: %s\n", dir); return; }
+    std::vector<std::string> nomes;
+    while (dirent* e = readdir(d)) {
+        std::string n = e->d_name;
+        if (n.size() > std::strlen(ext) && n.compare(n.size() - std::strlen(ext), std::string::npos, ext) == 0
+            && n.rfind("pkb_arm", 0) == 0) nomes.push_back(n);
+    }
+    closedir(d);
+    std::sort(nomes.begin(), nomes.end());
+    unsigned ok = 0, falhas = 0, funcoes = 0;
+    for (const std::string& n : nomes) {
+        std::string caminho = std::string(dir) + "/" + n;
+        std::string banco = n.substr(0, n.size() - std::strlen(ext));
+        void* h = dlopen(caminho.c_str(), RTLD_NOW | RTLD_LOCAL);
+        if (!h) { std::fprintf(stderr, "[pkb] dlopen falhou: %s\n", dlerror()); ++falhas; continue; }
+        auto* tab = (const NdsDispatchEntry*)dlsym(h, ("g_dispatch_" + banco).c_str());
+        auto* len = (const unsigned*)dlsym(h, ("g_dispatch_" + banco + "_len").c_str());
+        if (!tab || !len) { std::fprintf(stderr, "[pkb] %s sem tabela de despacho\n", n.c_str()); ++falhas; continue; }
+        bool arm7 = banco.find("_arm7_") != std::string::npos;
+        nds_register_dispatch(arm7 ? 1 : 0, tab, *len, arm7 ? 0x00000000u : 0xFFFF0000u);
+        ++ok; funcoes += *len;
+    }
+    std::fprintf(stderr, "[pkb] bancos de overlay: %u carregados, %u falhas, %u entradas de despacho (%s)\n",
+                 ok, falhas, funcoes, dir);
+}
