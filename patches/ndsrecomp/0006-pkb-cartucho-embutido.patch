 void pkb_load_overlay_banks(const char* rom_sha1) {
     if (!rom_sha1 || std::strcmp(rom_sha1, "26ad0b9967aa279c4a266ee69f52b9b2332399a5") != 0) return;
@@ -50,3 +52,25 @@
     std::fprintf(stderr, "[pkb] bancos de overlay: %u carregados, %u falhas, %u entradas de despacho (%s)\n",
                  ok, falhas, funcoes, dir);
 }
+
+// Formato cartucho.pkb (tools/empacotar.py): "PKBCART1" | u64 tamanho original | u64 tamanho útil |
+// 20 bytes SHA-1 do original | zlib(bytes úteis). O resto até o tamanho original é 0xFF (enchimento).
+std::vector<uint8_t> pkb_read_cart(const std::string& path,
+                                   std::vector<uint8_t> (*read_raw)(const std::string&)) {
+    if (path.size() < 4 || path.compare(path.size() - 4, 4, ".pkb") != 0) return read_raw(path);
+    std::ifstream f(path, std::ios::binary);
+    char magic[8] = {}; uint64_t orig = 0, util = 0; unsigned char sha[20];
+    f.read(magic, 8); f.read((char*)&orig, 8); f.read((char*)&util, 8); f.read((char*)sha, 20);
+    if (!f || std::memcmp(magic, "PKBCART1", 8) != 0 || util > orig || orig > (1ull << 30)) {
+        std::fprintf(stderr, "[pkb] cartucho inválido: %s\n", path.c_str()); return {};
+    }
+    std::vector<char> z((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    std::vector<uint8_t> out(orig, 0xFF);
+    uLongf n = (uLongf)util;
+    if (uncompress(out.data(), &n, (const Bytef*)z.data(), (uLong)z.size()) != Z_OK || n != util) {
+        std::fprintf(stderr, "[pkb] cartucho corrompido: %s\n", path.c_str()); return {};
+    }
+    std::fprintf(stderr, "[pkb] cartucho embutido: %s (%llu bytes, %zu comprimidos)\n", path.c_str(),
+                 (unsigned long long)orig, z.size());
+    return out;  // o runner confere o SHA-1 ao registrar os bancos do título
+}
