+// ── pokeblack-recomp (patch 0007): qualidade gráfica + controle no arquivo de configurações ──
+constexpr const char* kPkbQualityKey = "pkb.quality";
+constexpr const char* kPkbRestartKey = "pkb.restart";
+constexpr const char* kPkbPadResetKey = "pkb.pad.reset";
+constexpr const char* kPkbPadPrefix = "pkb.pad.";
+
+void pkb_load_settings(const std::string& path) {
+    if (path.empty()) return;
+    std::ifstream in(path);
+    std::string line;
+    while (std::getline(in, line)) {
+        const size_t eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        const std::string k = line.substr(0, eq);
+        const int v = std::atoi(line.c_str() + eq + 1);
+        if (k == "pkb_quality" && v >= 0 && v <= 3) g_pkb_quality = v;
+        if (k.rfind("pkb_pad_", 0) == 0) {
+            const int i = std::atoi(k.c_str() + 8);
+            if (i >= 0 && i < 12 && v >= -1 && v < 32) g_pkb_pad[i] = v;
+        }
+    }
+    std::fprintf(stderr, "[pkb] configuracoes: qualidade=%d\n", g_pkb_quality);
+}
+
+bool pkb_save_settings(const std::string& path) {
+    if (path.empty()) return false;
+    std::vector<std::string> lines;
+    {
+        std::ifstream in(path);
+        std::string line;
+        while (std::getline(in, line))
+            if (line.rfind("pkb_", 0) != 0) lines.push_back(line);
+    }
+    lines.push_back("pkb_quality=" + std::to_string(g_pkb_quality));
+    for (int i = 0; i < 12; ++i)
+        lines.push_back("pkb_pad_" + std::to_string(i) + "=" + std::to_string(g_pkb_pad[i]));
+    std::ofstream out(path, std::ios::trunc);
+    for (const std::string& l : lines) out << l << '\n';
+    return static_cast<bool>(out);
+}
+
+// Pede ao lançador para reabrir o jogo (arquivo "reiniciar" ao lado das configurações).
+void pkb_request_restart(const std::string& settings_path) {
+    std::filesystem::path p(settings_path);
+    std::ofstream(p.parent_path() / "reiniciar") << "1\n";
+}
