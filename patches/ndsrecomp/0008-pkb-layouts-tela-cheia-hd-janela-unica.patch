+static const char* kPkbBottomVertex = R"GLSL(#version 410 core
+out vec2 uv;
+void main() {
+    vec2 p = vec2(gl_VertexID == 1 ? 3.0 : -1.0, gl_VertexID == 2 ? 3.0 : -1.0);
+    uv = vec2((p.x + 1.0) * 0.5, 1.0 - (p.y + 1.0) * 0.5);
+    gl_Position = vec4(p, 0.0, 1.0);
+}
+)GLSL";
+static const char* kPkbBottomFragment = R"GLSL(#version 410 core
+uniform sampler2D tex;
+in vec2 uv;
+out vec4 color;
+void main() { color = vec4(texture(tex, uv).rgb, 1.0); }
+)GLSL";
+struct PkbRect { int x, y, w, h; };
+static void pkb_geometry(int layout, int* lw, int* lh, PkbRect* top, PkbRect* bottom) {
+    switch (layout) {
+        case 1: *lw = 512; *lh = 192; *top = {0, 0, 256, 192}; *bottom = {256, 0, 256, 192}; break;
+        case 2: *lw = 1024; *lh = 576; *top = {0, 0, 768, 576}; *bottom = {768, 384, 256, 192}; break;
+        default: *lw = 256; *lh = 384; *top = {0, 0, 256, 192}; *bottom = {0, 192, 256, 192}; break;
+    }
+}
+// Retângulo lógico -> viewport GL (origem embaixo à esquerda), conteúdo centralizado com tarjas.
+static void pkb_viewport(int dw, int dh, int lw, int lh, const PkbRect& r) {
+    const double s = std::min(static_cast<double>(dw) / lw, static_cast<double>(dh) / lh);
+    const double ox = (dw - lw * s) / 2.0, oy = (dh - lh * s) / 2.0;
+    const int x0 = static_cast<int>(ox + r.x * s + 0.5), x1 = static_cast<int>(ox + (r.x + r.w) * s + 0.5);
+    const int y0 = static_cast<int>(oy + (lh - r.y - r.h) * s + 0.5), y1 = static_cast<int>(oy + (lh - r.y) * s + 0.5);
+    glViewport(x0, y0, x1 - x0, y1 - y0);
+}
+void pkb_set_bottom_impl(const unsigned int* pixels, int width, int layout) {
+    g_pkb_bottom_pixels = pixels;
+    g_pkb_bottom_width = width;
+    g_pkb_layout = layout;
+}
+static bool pkb_draw_bottom(int dw, int dh) {
+    if (!g_pkb_bottom_program) {
+        GLuint v = compile_shader(GL_VERTEX_SHADER, kPkbBottomVertex);
+        GLuint f = compile_shader(GL_FRAGMENT_SHADER, kPkbBottomFragment);
+        if (!v || !f) return false;
+        g_pkb_bottom_program = glCreateProgram();
+        glAttachShader(g_pkb_bottom_program, v);
+        glAttachShader(g_pkb_bottom_program, f);
+        glLinkProgram(g_pkb_bottom_program);
+        glDeleteShader(v);
+        glDeleteShader(f);
+        GLint ok = GL_FALSE;
+        glGetProgramiv(g_pkb_bottom_program, GL_LINK_STATUS, &ok);
+        if (ok != GL_TRUE) return false;
+        glUseProgram(g_pkb_bottom_program);
+        glUniform1i(glGetUniformLocation(g_pkb_bottom_program, "tex"), 7);
+        glGenTextures(1, &g_pkb_bottom_texture);
+        glActiveTexture(GL_TEXTURE7);
+        glBindTexture(GL_TEXTURE_2D, g_pkb_bottom_texture);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 256, 192, 0, GL_BGRA, GL_UNSIGNED_BYTE, nullptr);
+    }
+    if (!g_pkb_bottom_pixels || g_pkb_bottom_width != 256) return true;  // larguras adaptativas: não usadas aqui
+    int lw, lh; PkbRect top, bottom;
+    pkb_geometry(g_pkb_layout, &lw, &lh, &top, &bottom);
+    glUseProgram(g_pkb_bottom_program);
+    glActiveTexture(GL_TEXTURE7);
+    glBindTexture(GL_TEXTURE_2D, g_pkb_bottom_texture);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 256, 192, GL_BGRA, GL_UNSIGNED_BYTE, g_pkb_bottom_pixels);
+    pkb_viewport(dw, dh, lw, lh, bottom);
+    glBindVertexArray(g_present_vao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    return true;
+}
